generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  github_login String   @unique
  name         String?
  avatar_url   String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt
  tasks        Task[]

  @@map("users")
}

model Task {
  id                  String        @id @default(cuid())
  github_issue_id     String
  github_issue_number Int?
  title               String
  body                String?
  url                 String?
  created_at          DateTime
  closed_at           DateTime?
  updated_at          DateTime      @updatedAt
  status              String        @default("Todo")
  repository          String?
  project_title       String?
  assignee_id         String?
  end_date            DateTime?
  start_date          DateTime?
  type                String?       @default("Issue")
  story_points        Float?
  project_number      Int?
  histories           TaskHistory[]
  labels              TaskLabel[]
  assignee            User?         @relation(fields: [assignee_id], references: [id])

  @@unique([github_issue_id, project_number])
  @@map("tasks")
}

model TaskLabel {
  id      String  @id @default(cuid())
  task_id String
  name    String
  color   String?
  task    Task    @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([task_id, name])
  @@map("task_labels")
}

model TaskHistory {
  id         String   @id @default(cuid())
  task_id    String
  old_status String?
  new_status String
  changed_at DateTime @default(now())
  task       Task     @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@map("task_histories")
}

model ProjectBucket {
  id             String          @id @default(cuid())
  project_number Int
  label          String
  is_done        Boolean         @default(false)
  sort_order     Int             @default(0)
  mappings       StatusMapping[]

  @@unique([project_number, label])
  @@map("project_buckets")
}

model StatusMapping {
  id             String         @id @default(cuid())
  project_number Int
  raw_status     String
  bucket_id      String?
  bucket         ProjectBucket? @relation(fields: [bucket_id], references: [id])

  @@unique([project_number, raw_status])
  @@map("status_mappings")
}

model SyncLog {
  id               String     @id @default(cuid())
  started_at       DateTime   @default(now())
  finished_at      DateTime?
  status           SyncStatus @default(RUNNING)
  message          String?
  items_synced     Int        @default(0)
  current_stage    String?
  processed_items  Int        @default(0)
  total_items      Int        @default(0)
  cancel_requested Boolean    @default(false)

  @@map("sync_logs")
}

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}
